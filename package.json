{
  "name": "pizzascript-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node worker/embed-child.mjs --warm",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate:blog": "tsx --env-file-if-exists=.env.local scripts/migrate-blog.ts",
    "assets:import": "node scripts/optimize-assets.mjs ../website",
    "css:import": "node scripts/port-legacy-css.mjs ../website",
    "seed:studio": "tsx --env-file-if-exists=.env.local scripts/seed-studio.ts",
    "worker": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "publish:due": "tsx --env-file-if-exists=.env.local worker/publish-cli.ts",
    "check:studio": "tsx scripts/check-studio-logic.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@google/genai": "^3.6.0",
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "^4.3.2",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "fast-xml-parser": "^5.12.1",
    "google-auth-library": "^11.3.4",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.75.0",
    "lucide-static": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "simple-icons": "^16.38.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "node-html-parser": "^9.0.7",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
