# Copy to .env.local for local development. Which keys go where:
#   Vercel (site + admin):       SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, REVALIDATE_SECRET, NEXT_PUBLIC_FRAMES_BASE_URL
#   GitHub Actions (agent worker, repo secrets): SUPABASE_URL, SUPABASE_SECRET_KEY, GEMINI_API_KEY, GSC_*, SITE_URL, REVALIDATE_SECRET
#   Local scripts only:          SUPABASE_SECRET_KEY, ADMIN_EMAIL

# ── Supabase (Project Settings → API) ──
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — protected by Row Level Security.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key — scripts and the worker only. Never on Vercel, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Email allowed into /admin (seed:studio --write adds it to the admins table).
ADMIN_EMAIL=

# Shared secret for POST /api/revalidate (worker + Supabase webhook send it as "x-revalidate-secret").
REVALIDATE_SECRET=

# ── Agent worker ──
# Free key from aistudio.google.com (no billing attached = free tier).
GEMINI_API_KEY=
# Optional overrides.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Full JSON of the Google service account (contents of gsc-private-key.json, on one line). Leave empty to skip GSC.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=sc-domain:pizzascript.com
SITE_URL=https://www.pizzascript.com

# ── Site ──
# Optional: custom domain in front of the R2 bucket with the scroll-animation frames.
NEXT_PUBLIC_FRAMES_BASE_URL=

# ── Agent server (worker/server.ts) ──
# Admin (Vercel) → POST WORKER_URL/run with header x-worker-secret. Same WORKER_SECRET on the server.
# Vercel needs WORKER_URL + WORKER_SECRET; the Render service needs WORKER_SECRET + the worker keys above.
WORKER_URL=
WORKER_SECRET=
